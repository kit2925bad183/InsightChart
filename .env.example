# Copy to .env.local and fill in. Never commit .env.local — it is git-ignored.

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase dashboard → your project → Connect → "Transaction pooler" connection string
# (port 6543). Replace [YOUR-PASSWORD] with the database password. Required on Vercel.
# Leave empty for local development: an embedded Postgres in ./data/pglite is used instead.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Initial accounts ─────────────────────────────────────────────────────────
# Used ONLY to create the two initial accounts the first time the server starts
# (or when you run `npm run db:migrate`). If the account already exists these are
# ignored, so changing them later does NOT reset a password. After signing in with
# these, each person can change the password by email or keep it. Min 8 characters.
CREATOR_ADMIN_INITIAL_PASSWORD=
ADMINISTRATOR_INITIAL_PASSWORD=

# ── Email (needed to send the 6-digit codes for password change / forgot password) ──
# For Gmail you only need SMTP_USER and SMTP_PASS:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Put your Gmail address in SMTP_USER and the 16-letter App Password in SMTP_PASS
#      (spaces are fine). Your normal Gmail password will NOT work.
#   4. Check it: npm run email:test -- your.address@gmail.com
SMTP_USER=
SMTP_PASS=
# Defaults for Gmail — change only for another provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional sender name/address (defaults to "InsightChart <SMTP_USER>").
# EMAIL_FROM="InsightChart <your.address@gmail.com>"

# ── Optional ─────────────────────────────────────────────────────────────────
# Public address used for the sign-in link in account emails (e.g. https://insightchart.example.edu).
# Defaults to the address the admin used when creating the account.
# APP_URL=
# Email domains accepted for account emails. Comma-separated, or * for any domain.
# ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com
# Old SQLite database to import with `npm run db:import-sqlite` (default: ./data/insightchart.db).
# INSIGHTCHART_DB_PATH=./data/insightchart.db
